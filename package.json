{
  "name": "e-hiseb-backend",
  "version": "1.0.0",
  "description": "ই-হিসেব - Workshop Management System Backend (Hono + Bun + Drizzle + Neon)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "build:bun": "bun build src/index.ts --target=bun --outdir=dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "lint": "tsc --noEmit",
    "build": "node scripts/vercel-bundle.mjs",
    "vercel-build": "node scripts/vercel-bundle.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "drizzle-zod": "^0.6.1",
    "hono": "^4.6.16",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
